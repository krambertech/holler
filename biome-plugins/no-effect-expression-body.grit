or {
  `useEffect($effect, $_)`,
  `useLayoutEffect($effect, $_)`
} where {
  $effect <: `() => $body`,
  // A block body, or an arrow that is the cleanup itself: () => () => stop().
  $body <: not or {
    JsFunctionBody(),
    JsArrowFunctionExpression()
  },
  register_diagnostic(span=$effect, message="An effect written as () => expression returns that expression, and React calls whatever comes back as its cleanup, so the page crashes when it is not a function. Write the body in braces: () => { ... }.")
}
