{
  "name": "@holler/site",
  "version": "0.0.1",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run",
    "typecheck": "astro check && tsc -p tsconfig.worker.json",
    "test": "vitest run --passWithNoTests",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@holler/core": "workspace:*",
    "@holler/design": "workspace:*",
    "astro": "^7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
