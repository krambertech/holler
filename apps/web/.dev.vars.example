# Copy to .dev.vars for local development. Never commit .dev.vars.
# The origin you open the product on. Better Auth refuses sign-out and other writes from any other origin.
PRODUCT_URL=http://localhost:5280
BETTER_AUTH_SECRET=local-secret-at-least-thirty-two-characters-long
# A 32-byte key, base64. Generate with: openssl rand -base64 32
SLACK_TOKEN_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# From the Slack app's Basic Information page. Leave empty to use the dev personas only.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Polar, sandbox (sandbox.polar.sh). Leave empty to run without billing. docs/billing.md has the setup.
POLAR_SERVER=sandbox
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_TEAM_MONTHLY_PRODUCT_ID=
POLAR_TEAM_YEARLY_PRODUCT_ID=
