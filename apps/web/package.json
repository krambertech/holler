{
  "name": "@holler/web",
  "version": "0.0.1",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && pnpm design:build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy -c dist/holler/wrangler.json",
    "deploy:check": "wrangler deploy --dry-run -c dist/holler/wrangler.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "test": "vitest run --passWithNoTests",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "wrangler d1 migrations apply holler --local",
    "db:migrate:prod": "wrangler d1 migrations apply holler --remote",
    "auth:schema": "auth generate --config src/server/auth-cli.ts --output ../../packages/core/src/schema/auth.ts -y",
    "design:dev": "vite --config vite.design.config.ts",
    "design:build": "vite build --config vite.design.config.ts",
    "design:deploy": "pnpm design:build && wrangler deploy -c wrangler.design.jsonc",
    "design:check": "pnpm design:build && wrangler deploy --dry-run -c wrangler.design.jsonc"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/api-key": "1.7.27",
    "@better-auth/cimd": "1.7.27",
    "@better-auth/core": "1.7.27",
    "@better-auth/mcp": "1.7.27",
    "@better-auth/oauth-provider": "1.7.27",
    "@holler/core": "workspace:*",
    "@holler/design": "workspace:*",
    "@hono/standard-validator": "^0.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@polar-sh/better-auth": "2.1.5",
    "@polar-sh/sdk": "1.3.2",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.46",
    "better-auth": "1.7.27",
    "clsx": "^2.1.1",
    "hono": "^4.13.19",
    "hono-openapi": "1.3.5",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.43",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "auth": "1.7.27",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
