{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm verify)",
      "Bash(pnpm fix)",
      "Bash(pnpm check:*)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm test:*)",
      "Bash(pnpm build)",
      "Bash(pnpm install)",
      "Bash(pnpm db:migrate)",
      "Bash(pnpm db:generate)",
      "Bash(pnpm --filter *)",
      "Bash(pnpm exec vitest *)",
      "Bash(pnpm exec playwright *)",
      "Bash(node .agents/skills/*)",
      "Bash(node scripts/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git fetch*)",
      "Bash(git branch*)",
      "Bash(git rebase origin/main)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr diff*)",
      "Bash(gh run view*)",
      "Bash(gh run list*)"
    ],
    "deny": [
      "Bash(pnpm deploy*)",
      "Bash(pnpm db:migrate:prod*)",
      "Bash(pnpm --filter @holler/web deploy*)",
      "Bash(pnpm --filter @holler/web db:migrate:prod*)",
      "Bash(pnpm --filter @holler/web design:deploy*)",
      "Bash(pnpm --filter @holler/site deploy*)",
      "Bash(*wrangler deploy*)",
      "Bash(*wrangler versions deploy*)",
      "Bash(*wrangler secret *)",
      "Bash(*wrangler d1 * --remote*)",
      "Bash(*wrangler d1 delete*)",
      "Bash(git push origin main*)",
      "Bash(git push --force origin main*)",
      "Bash(git push -f*)",
      "Bash(git push --force *)",
      "Bash(gh pr merge*)",
      "Bash(gh repo delete*)",
      "Read(apps/web/.dev.vars)",
      "Read(apps/site/.dev.vars)"
    ]
  }
}
