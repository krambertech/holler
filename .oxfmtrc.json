{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "sortPackageJson": false,
  "sortImports": {
    "newlinesBetween": false,
    "partitionByNewline": true,
    "groups": ["builtin", "external", "internal", ["parent", "sibling", "index"], "unknown"]
  },
  "ignorePatterns": [
    "**/dist",
    "**/dist-design",
    "**/.astro",
    "**/*.astro",
    "**/node_modules",
    "**/.wrangler",
    "**/routeTree.gen.ts",
    "**/migrations",
    "**/public",
    "**/worker-configuration.d.ts",
    "apps/web/index.html",
    "apps/web/design/index.html",
    "docs/design",
    "**/*.md",
    "**/*.mdx",
    "**/*.yml",
    "**/*.yaml",
    "**/*.html",
    "**/*.toml",
    "**/*.svg",
    ".claude",
    "pnpm-lock.yaml"
  ],
  "overrides": [
    {
      "files": ["**/*.json", "**/*.jsonc"],
      "options": {
        "trailingComma": "none"
      }
    }
  ]
}
