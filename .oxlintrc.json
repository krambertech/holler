{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./oxlint-limits.json"],
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "react", "jsx-a11y", "import"],
  "jsPlugins": ["./oxlint-plugin-holler/index.mjs"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "**/dist",
    "**/dist-design",
    "**/.astro",
    "**/node_modules",
    "**/.wrangler",
    "**/routeTree.gen.ts",
    "**/migrations",
    "**/public",
    "**/worker-configuration.d.ts",
    "apps/web/index.html",
    "apps/web/design/index.html",
    "docs/design",
    ".claude"
  ],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/no-array-index-key": "error",
    "react-hooks/exhaustive-deps": "error",
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": [
      "error",
      {
        "disallowTypeAnnotations": false
      }
    ],
    "typescript/no-floating-promises": [
      "error",
      {
        "allowForKnownSafeCalls": [
          { "from": "package", "package": "node:test", "name": ["test", "it", "describe"] }
        ]
      }
    ],
    "typescript/no-misused-promises": [
      "error",
      {
        "checksVoidReturn": { "attributes": false }
      }
    ],
    "typescript/no-duplicate-type-constituents": "off",
    "typescript/no-misused-spread": "off",
    "typescript/require-array-sort-compare": "off",
    "typescript/restrict-template-expressions": "off",
    "typescript/unbound-method": "off",
    "react/refs": "off",
    "react/set-state-in-effect": "off",
    "react/purity": "off",
    "react/immutability": "off",
    "react/use-memo": "off",
    "react/globals": "off",
    "react/preserve-manual-memoization": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/no-autofocus": "off",
    "jsx-a11y/control-has-associated-label": "off",
    "unicorn/no-useless-spread": "off",
    "unicorn/no-useless-fallback-in-spread": "off",
    "unicorn/no-new-array": "off",
    "unicorn/prefer-string-starts-ends-with": "off",
    "typescript/triple-slash-reference": "off",
    "oxc/only-used-in-recursion": "off",
    "oxc/erasing-op": "off",
    "holler/no-comments": "error",
    "eslint/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_",
        "destructuredArrayIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ]
  },
  "overrides": [
    {
      "files": ["apps/web/src/client/**"],
      "excludeFiles": ["apps/web/src/client/routes/**"],
      "rules": {
        "unicorn/filename-case": [
          "error",
          {
            "case": "kebabCase"
          }
        ]
      }
    },
    {
      "files": ["apps/**", "e2e/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["drizzle-orm", "drizzle-orm/**"],
                "message": "Import Drizzle from @holler/core/db. Better Auth brings Kysely, and a second import makes pnpm build two Drizzles whose types do not match."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "apps/web/src/server/routes/**",
        "apps/web/src/server/slack/**",
        "apps/web/src/server/mcp/**"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@holler/core/db",
                  "@holler/core/schema*",
                  "drizzle-orm",
                  "drizzle-orm/**"
                ],
                "message": "Routes, Slack handlers and MCP tools call a service in src/server/services; only services touch Drizzle."
              },
              {
                "group": ["**/db"],
                "importNames": ["schema"],
                "message": "Routes, Slack handlers and MCP tools call a service in src/server/services; only services read the schema."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/client/**"],
      "excludeFiles": ["**/*.test.tsx", "apps/web/src/client/lib/use-reduce-motion.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "motion/react",
                "importNames": ["useReducedMotion"],
                "message": "Use useReduceMotion() from @/lib/use-reduce-motion, which also honours the design page's reduced-motion switch."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/client/**"],
      "rules": {
        "holler/no-effect-expression-body": "error"
      }
    },
    {
      "files": ["apps/web/src/**"],
      "excludeFiles": ["apps/web/src/client/design/**", "**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "holler/product-links": "error"
      }
    },
    {
      "files": ["e2e/**"],
      "excludeFiles": ["e2e/a11y.ts", "e2e/fixtures.ts"],
      "rules": {
        "holler/sign-in-lands": "error"
      }
    },
    {
      "files": ["e2e/**"],
      "rules": {
        "holler/test-owns-its-workspace": "error"
      }
    },
    {
      "files": [
        "e2e/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.test.mjs",
        "playwright.config.ts",
        "**/vitest.config.ts"
      ],
      "rules": {
        "holler/no-flaky-escape": "error"
      }
    },
    {
      "files": ["apps/web/src/client/**"],
      "excludeFiles": ["apps/web/src/client/design/**"],
      "rules": {
        "holler/typed-navigation": "error"
      }
    },
    {
      "files": ["apps/web/src/server/**", "packages/core/src/**"],
      "rules": {
        "holler/no-sql-lower": "error",
        "holler/no-spread-rows": "error",
        "holler/no-multi-row-insert": "error",
        "holler/bounded-in-array": "error",
        "holler/no-mocked-services": "error"
      }
    },
    {
      "files": ["apps/web/src/server/**"],
      "excludeFiles": [
        "apps/web/src/server/services/audit.ts",
        "apps/web/src/server/services/dev-*.ts",
        "apps/web/src/server/services/*fixtures.ts",
        "**/*.test.ts"
      ],
      "rules": {
        "holler/activity-with-write": "error"
      }
    },
    {
      "files": ["e2e/**"],
      "excludeFiles": ["e2e/fixtures.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@playwright/test",
                "importNames": ["test", "expect"],
                "message": "Import test and expect from ./fixtures, which fails a test whose page logs an error."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/**", "packages/core/src/**"],
      "excludeFiles": [
        "packages/core/src/schema/**",
        "apps/web/src/server/services/own-answers.ts",
        "apps/web/src/server/services/responses.ts",
        "apps/web/src/server/services/dev-seed.ts",
        "**/*.test.ts"
      ],
      "rules": {
        "holler/no-response-owners": "error"
      }
    }
  ]
}
